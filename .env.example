# ==========================================
# ReviewMitra - Environment Variables Configuration
# ==========================================

# Database (PostgreSQL for Vercel/Production, SQLite for Local Dev)
# For Local Dev: DATABASE_URL="file:./db/dev.db"
# For Production (Neon / Supabase):
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/reviewmitra?sslmode=require"

# NextAuth Authentication
NEXTAUTH_URL="https://reviewmitra.in"
NEXTAUTH_SECRET="your-super-strong-nextauth-secret-min-32-chars"

# Token Encryption (AES-256-GCM secret key, exactly 32 characters or hex)
ENCRYPTION_KEY="12345678901234567890123456789012"

# AI Provider (Google Gemini 2.0 Flash recommended for MSME & Hinglish)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
# Fallback (optional):
# OPENAI_API_KEY="sk-proj-YourOpenAiKey"

# Google Business Profile OAuth Integration
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-yourGoogleClientSecret"

# Facebook / Meta Page Integration
FACEBOOK_APP_ID="your_meta_app_id"
FACEBOOK_APP_SECRET="your_meta_app_secret"

# Razorpay Subscriptions (Test / Live)
RAZORPAY_KEY_ID="rzp_test_or_live_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_custom_webhook_secret_set_in_razorpay"

# WhatsApp Alerts (Meta WhatsApp Cloud API or Twilio)
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_API_TOKEN="your_meta_system_user_token"

# Cron Job Protection
CRON_SECRET="your_random_secret_string_for_cron_endpoints"
