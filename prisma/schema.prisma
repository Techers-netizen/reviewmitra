// ReviewMitra - Local Business Review Aggregator & Agentic AI Auto-Reply SaaS
// Production PostgreSQL Schema (Zero Dummy Data, Multi-Business, OpenWA & Direct QR)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String     @id @default(cuid())
  fullName                String
  phoneNumber             String?    @unique
  email                   String?    @unique
  passwordHash            String?
  authProvider            String     @default("email") // 'email', 'google', 'both'
  emailVerified           Boolean    @default(false)
  verificationToken       String?    @unique
  verificationTokenExpiry DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  businesses              Business[]
}

model Business {
  id                   String               @id @default(cuid())
  ownerId              String
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessName         String
  category             String?              // 'clinic', 'salon', 'gym', 'restaurant', 'retail', 'b2b'
  city                 String?
  phoneSupport         String?              // injected into negative replies
  // Direct platform links for QR Review Booster & No-API Scrapers
  googlePlaceId        String?
  googleReviewUrl      String?
  facebookPageUrl      String?
  justdialUrl          String?
  indiamartUrl         String?
  indiamartMobile      String?
  indiamartEmail       String?
  // AI & Auto-reply settings
  defaultTone          String               @default("friendly")
  matchReviewLanguage  Boolean              @default(true) // Always reply in the exact language of the review
  autoReplyPositive    Boolean              @default(true)
  autoReplyNeutral     Boolean              @default(false)
  autoReplyDelay       Int                  @default(5)    // minutes before auto-posting
  // OpenWA (QR / Pairing Code) WhatsApp Reporting
  notifyWhatsapp       Boolean              @default(true)
  notifyWhatsappNumber String?
  dailyDigestEnabled   Boolean              @default(true)
  openwaStatus         String               @default("disconnected") // 'disconnected', 'qr_ready', 'connected'
  openwaSessionData    String?              // Encrypted session state / pairing info
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  connections          PlatformConnection[]
  reviews              Review[]
  subscriptions        Subscription[]
}

model PlatformConnection {
  id                    String    @id @default(cuid())
  businessId            String
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platformName          String    // 'google', 'facebook', 'justdial', 'indiamart'
  externalAccountId     String?
  listingUrl            String?
  // AES-256-GCM encrypted fields
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenIv               String?
  tokenAuthTag          String?
  status                String    @default("connected") // 'connected', 'expired', 'error'
  lastSyncAt            DateTime?
  createdAt             DateTime  @default(now())

  @@unique([businessId, platformName])
}

model Review {
  id                String        @id @default(cuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platformName      String        // 'google', 'facebook', 'justdial', 'indiamart', 'qr_direct'
  externalReviewId  String
  reviewerName      String
  reviewerAvatarUrl String?
  customerPhone     String?       // captured when submitted via in-store QR shield
  rating            Int           // 1-5
  reviewText        String?
  detectedLanguage  String?       @default("en") // 'hi', 'en', 'hinglish', 'gu', 'mr', 'ta', etc.
  sentiment         String        @default("neutral") // 'positive', 'neutral', 'negative'
  reviewTimestamp   DateTime
  isReplied         Boolean       @default(false)
  rawPayload        String?
  createdAt         DateTime      @default(now())
  replies           ReviewReply[]

  @@unique([platformName, externalReviewId])
  @@index([businessId, reviewTimestamp])
}

model ReviewReply {
  id            String   @id @default(cuid())
  reviewId      String
  review        Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  businessId    String
  replyText     String
  generatedByAi Boolean  @default(true)
  aiToneUsed    String?
  languageUsed  String?
  postStatus    String   @default("posted") // 'posted', 'copied_to_clipboard', 'failed'
  isAutoReply   Boolean  @default(false)
  isDraft       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Subscription {
  id                     String    @id @default(cuid())
  businessId             String
  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planName               String    // 'test_1', 'nano_79', 'starter_149', 'growth_249', 'pro_399'
  dodoSubscriptionId     String?   @unique
  dodoPaymentId          String?
  razorpaySubscriptionId String?   @unique
  status                 String    @default("active") // 'active', 'past_due', 'cancelled'
  taxExclusive           Boolean   @default(true)     // 18% GST paid by customer on top of base plan price
  currentPeriodEnd       DateTime?
  monthlyAiReplyLimit    Int       @default(100)
  maxBusinesses          Int       @default(1)
  aiRepliesUsed          Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}
